# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_
# Server-only secret key for trusted jobs and admin adapters.
SUPABASE_SECRET_KEY=sb_secret_
# Canonical protected admin origin, without a trailing slash.
ADMIN_ORIGIN=https://admin.gologs.com.ng
# development | test | preview | production
APP_ENV=production
# Production email delivery settings.
EMAIL_DELIVERY_ENABLED=true
# Supported providers: console, resend. Production requires resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# This sender domain must be verified in Resend.
EMAIL_FROM=GO Admin <admin@gologs.com.ng>
# Copy the whsec_ value from the matching webhook in Resend.
EMAIL_WEBHOOK_SIGNING_SECRET=
# Generate an independent random URL token; this is not supplied by Resend.
EMAIL_WEBHOOK_ENDPOINT_TOKEN=

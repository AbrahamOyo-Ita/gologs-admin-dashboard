{
  "name": "go-admin-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace admin",
    "build": "npm run build --workspace admin",
    "lint": "npm run lint --workspace admin",
